# Every setting below is optional. The translator runs offline with no
# configuration at all — copy this to .env only if you want to change something.

# --- Data ---
# Defaults to ../tu_dien_viet_tay_nung_parsed.xlsx
# EXCEL_GLOSSARY_PATH=C:\path\to\tu_dien_viet_tay_nung_parsed.xlsx

# --- Retrieval and decoding ---
# Swept on held-out data; see code/README.md before changing.
# RETRIEVE_K=2              # example sentences retrieved per query
# LM_DECODE=1               # Viterbi sequence decoding
# LM_WEIGHT=0.10            # fluency vs dictionary score
# MINED_PHRASES=1           # phrase table mined from word alignments
# MINED_PHRASE_SCORE=18.0   # ranks below attested dictionary examples (20)
# FUZZY_MATCH=1             # edit-distance fallback for misspellings
# ALIGN_MODEL=0             # learned IBM Model 1 probabilities (measured: no gain)

# --- Optional LLM editing pass ---
# Disabled by default because both local models measured WORSE than the
# dictionary layer. Re-run `python eval_translation.py --n 80 --llm` and beat
# chrF 0.441 before turning this on.
# USE_LLM=0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=              # blank = auto-select the largest installed model

# --- Speech to text (optional, needs ffmpeg on PATH) ---
# Whisper has no Tày language code; it runs as Vietnamese with a Tày prompt.
# WHISPER_STT_MODEL=base
# WHISPER_STT_LANGUAGE=vi
